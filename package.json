{
  "name": "pmg-library",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron .",
    "desktop": "electron desktop/main.cjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "icons": "node scripts/make-icon.mjs",
    "dist:win": "electron-builder --config electron-builder.cjs --win nsis --x64 --publish never",
    "pack:win": "electron-builder --config electron-builder.cjs --win dir --x64 --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "desktop/main.cjs",
  "description": "PMG库 · Windows 钞票档案与图片组管理",
  "author": "YushenDu224",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "@resvg/resvg-js": "2.6.2"
  }
}
